APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Set only while bootstrapping the temporary production admin. Use a password
# of at least 16 characters, and keep both values in private environment storage.
TEMPORARY_ADMIN_EMAIL=
TEMPORARY_ADMIN_PASSWORD=

STORE_OWNER_NAME=
STORE_PHONE=
STORE_WHATSAPP=
STORE_COPYRIGHT=Bikrify
STORE_ANNOUNCEMENTS="Cash on delivery available|Thoughtful everyday picks"
STORE_OFFER_TITLE=
STORE_OFFER_DESCRIPTION=
STORE_OFFER_BADGE=SPECIAL OFFER
STORE_OFFER_CODE=

# Configure a merchant SMS provider for live phone OTP delivery.
SMS_DRIVER=log
SMS_API_ENDPOINT=
SMS_API_TOKEN=
SMS_AUTH_HEADER=Authorization
SMS_AUTH_PREFIX="Bearer "
SMS_PHONE_FIELD=to
SMS_MESSAGE_FIELD=message

# Each shop install uses that merchant's own Pathao credentials.
COURIER_DEFAULT=pathao
COURIER_PATHAO_ENABLED=false
COURIER_PATHAO_SANDBOX=true
COURIER_PATHAO_CLIENT_ID=
COURIER_PATHAO_CLIENT_SECRET=
COURIER_PATHAO_USERNAME=
COURIER_PATHAO_PASSWORD=
COURIER_PATHAO_STORE_ID=
COURIER_PATHAO_WEBHOOK_SECRET=
COURIER_HTTP_RETRY=0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
